# কপি করে .env.docker নামে রাখুন। এই ফাইল কখনো git-এ তুলবেন না।
# লম্বা এলোমেলো মান: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# সাইটের আসল ঠিকানা (https সহ, শেষে / ছাড়া)। /api একই ডোমেইনে হলেও এটা দেওয়া নিরাপদ।
CORS_ORIGINS=https://আপনার-ডোমেইন.com
# Nginx একটাই থাকলে 1। Cloudflare-ও সামনে থাকলে 2
TRUST_PROXY=1

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- ট্র্যাকিং (সব ঐচ্ছিক, খালি থাকলে বন্ধ) ----------
# ফ্রন্টএন্ড build এর সময় লাগে (বদলালে আবার --build করতে হবে)
VITE_FB_PIXEL_ID=
VITE_GA4_ID=
VITE_CLARITY_ID=
VITE_TIKTOK_PIXEL_ID=
# ব্যাকএন্ড (সার্ভার থেকে Conversions API ও GA4)
FB_PIXEL_ID=
FB_CAPI_TOKEN=
# শুধু টেস্টের সময়, লাইভে খালি
FB_TEST_EVENT_CODE=
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
