MONGO_URI=mongodb://127.0.0.1:27017/tayyib_shop
PORT=5000

# কোন কোন ওয়েবসাইট ব্যাকএন্ড ডাকতে পারবে (কমা দিয়ে, শেষে / ছাড়া)। খালি রাখলে সবাই পারবে।
# লোকাল: http://localhost:5173  |  আসল: আপনার Vercel/নিজের ডোমেইন
CORS_ORIGINS=http://localhost:5173

# Steadfast কুরিয়ার (মার্চেন্ট ড্যাশবোর্ড/সাপোর্ট থেকে পাওয়া কী)। কোডে বা চ্যাটে কখনো লিখবেন না।
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
# STEADFAST_BASE_URL=https://portal.packzy.com/api/v1

# Pathao কুরিয়ার (মার্চেন্ট প্যানেল → Developer's API থেকে)। আসল মান শুধু Render-এ বসান, এখানে বা চ্যাটে নয়।
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
# PATHAO_BASE_URL=https://api-hermes.pathao.com

JWT_SECRET=এখানে_একটা_লম্বা_এলোমেলো_গোপন_লেখা_বসান
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=এখানে_নিজের_মজবুত_পাসওয়ার্ড_বসান

# Cloudinary (ছবি আপলোডের জন্য) — আসল মান শুধু Render-এ বসান, এখানে নয়
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# অর্ডারে transaction (স্টক কমা + কুপন + অর্ডার সেভ একসাথে, নয়তো কিছুই না)।
# true দিলে সার্ভার চালুর সময় নিজে দেখে নেয় ডাটাবেজ পারে কি না: Atlas/replica set হলে চালু হয়,
# একক MongoDB হলে অর্ডার আগের মতোই চলে (বন্ধ হয় না) আর লগে সতর্কবার্তা আসে। Atlas-এ true দেওয়া নিরাপদ।
USE_TRANSACTIONS=

# ---------- ট্র্যাকিং (সব ঐচ্ছিক, খালি থাকলে বন্ধ) ----------
# Facebook Conversions API (Events Manager > Pixel > Settings > Conversions API > Generate access token)
FB_PIXEL_ID=
FB_CAPI_TOKEN=
# শুধু টেস্টের সময় Events Manager > Test Events এর কোড। লাইভে অবশ্যই খালি রাখুন।
FB_TEST_EVENT_CODE=
# GA4 Measurement Protocol। GA4_MEASUREMENT_ID হুবহু ফ্রন্টএন্ডের VITE_GA4_ID এর সমান (G-XXXX)
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
